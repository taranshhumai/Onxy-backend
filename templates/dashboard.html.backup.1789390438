<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#09090b">
<title>ONYX — Command Center</title>

<style>
:root{
  --bg:#08090c;
  --surface:rgba(255,255,255,.055);
  --surface2:rgba(255,255,255,.075);
  --line:rgba(255,255,255,.09);
  --text:#f5f5f7;
  --muted:#92949d;
  --soft:#c8c9cf;
  --green:#35d07f;
  --blue:#5e9cff;
  --red:#ff5c6c;
  --radius:24px;
  --shadow:0 24px 80px rgba(0,0,0,.34);
}

*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;
  min-height:100vh;
  color:var(--text);
  background:
    radial-gradient(circle at 15% -10%,rgba(94,156,255,.14),transparent 32%),
    radial-gradient(circle at 90% 15%,rgba(53,208,127,.08),transparent 28%),
    var(--bg);
  font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","SF Pro Text",
              Inter,system-ui,sans-serif;
  -webkit-font-smoothing:antialiased;
}
button{font:inherit;color:inherit}
button{cursor:pointer}
button:focus-visible{
  outline:2px solid var(--blue);
  outline-offset:3px;
}

.ambient{
  position:fixed;
  inset:-25%;
  z-index:-1;
  pointer-events:none;
  filter:blur(70px);
  opacity:.55;
}
.orb{
  position:absolute;
  width:30vw;
  height:30vw;
  min-width:240px;
  min-height:240px;
  border-radius:50%;
  background:rgba(94,156,255,.08);
  animation:float 14s ease-in-out infinite alternate;
}
.orb:nth-child(2){
  right:4%;
  top:25%;
  background:rgba(53,208,127,.055);
  animation-delay:-5s;
}
@keyframes float{
  from{transform:translate3d(-4%,-3%,0)}
  to{transform:translate3d(7%,5%,0)}
}

.app{
  width:min(1120px,calc(100% - 32px));
  margin:auto;
  padding:24px 0 80px;
}

.topbar{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:4px 2px 34px;
}
.brand{
  display:flex;
  align-items:center;
  gap:12px;
}
.logo{
  width:40px;
  height:40px;
  border:1px solid var(--line);
  border-radius:13px;
  display:grid;
  place-items:center;
  background:linear-gradient(145deg,rgba(255,255,255,.12),rgba(255,255,255,.025));
  box-shadow:inset 0 1px rgba(255,255,255,.12),var(--shadow);
  font-size:13px;
  font-weight:800;
  letter-spacing:.08em;
}
.brand-name{
  font-size:16px;
  font-weight:700;
  letter-spacing:.04em;
}
.brand-sub{
  margin-top:2px;
  color:var(--muted);
  font-size:11px;
}
.live{
  display:flex;
  align-items:center;
  gap:8px;
  color:var(--soft);
  font-size:12px;
}
.live-dot{
  width:7px;height:7px;border-radius:50%;
  background:var(--green);
  box-shadow:0 0 0 5px rgba(53,208,127,.08),0 0 16px rgba(53,208,127,.55);
  animation:pulse 2s ease-in-out infinite;
}
@keyframes pulse{
  50%{box-shadow:0 0 0 8px rgba(53,208,127,0),0 0 22px rgba(53,208,127,.2)}
}

.hero{
  padding:34px 0 42px;
}
.eyebrow{
  color:var(--muted);
  font-size:11px;
  text-transform:uppercase;
  letter-spacing:.18em;
  margin-bottom:12px;
}
h1{
  margin:0;
  max-width:720px;
  font-size:clamp(38px,7vw,72px);
  line-height:.98;
  letter-spacing:-.055em;
  font-weight:700;
}
.hero-copy{
  max-width:590px;
  margin:20px 0 0;
  color:var(--muted);
  font-size:15px;
  line-height:1.7;
}

.system-card{
  position:relative;
  overflow:hidden;
  display:flex;
  justify-content:space-between;
  gap:20px;
  align-items:center;
  padding:22px 24px;
  margin-bottom:54px;
  border:1px solid var(--line);
  border-radius:var(--radius);
  background:linear-gradient(145deg,rgba(255,255,255,.075),rgba(255,255,255,.025));
  backdrop-filter:blur(24px);
  -webkit-backdrop-filter:blur(24px);
  box-shadow:var(--shadow),inset 0 1px rgba(255,255,255,.08);
}
.system-card:before{
  content:"";
  position:absolute;
  inset:0;
  pointer-events:none;
  background:linear-gradient(110deg,transparent 25%,rgba(255,255,255,.045),transparent 65%);
  transform:translateX(-100%);
  animation:shine 7s ease-in-out infinite;
}
@keyframes shine{
  35%,100%{transform:translateX(100%)}
}
.system-title{font-size:14px;font-weight:650}
.system-meta{font-size:12px;color:var(--muted);margin-top:5px}
.system-status{
  flex:none;
  padding:9px 13px;
  border-radius:999px;
  background:rgba(53,208,127,.08);
  color:var(--green);
  border:1px solid rgba(53,208,127,.16);
  font-size:11px;
  font-weight:650;
}

.section-label{
  margin-bottom:18px;
  color:var(--muted);
  font-size:11px;
  text-transform:uppercase;
  letter-spacing:.16em;
}

.modules{
  display:flex;
  flex-direction:column;
  gap:12px;
}

.module{
  position:relative;
  width:100%;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:20px;
  min-height:88px;
  padding:20px 22px;
  text-align:left;
  border:1px solid var(--line);
  border-radius:20px;
  background:rgba(255,255,255,.035);
  transition:
    transform .35s cubic-bezier(.2,.8,.2,1),
    background .25s,
    border-color .25s,
    box-shadow .35s;
}
.module:hover{
  transform:translateY(-2px);
  background:var(--surface);
  border-color:rgba(255,255,255,.15);
  box-shadow:0 18px 45px rgba(0,0,0,.2);
}
.module:active{transform:scale(.985)}
.module-left{display:flex;align-items:center;gap:16px;min-width:0}
.module-icon{
  width:42px;height:42px;
  flex:none;
  display:grid;place-items:center;
  border-radius:14px;
  background:rgba(255,255,255,.055);
  border:1px solid var(--line);
  color:var(--soft);
}
.module-title{font-size:15px;font-weight:650}
.module-desc{
  margin-top:4px;
  color:var(--muted);
  font-size:12px;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}
.arrow{
  flex:none;
  color:#777983;
  font-size:19px;
  transition:transform .25s,color .25s;
}
.module:hover .arrow{
  transform:translateX(4px);
  color:var(--text);
}

.footer{
  padding:38px 4px 0;
  color:#62646d;
  font-size:11px;
  display:flex;
  justify-content:space-between;
}

/* PIP */
.pip-backdrop{
  position:fixed;
  inset:0;
  z-index:50;
  background:rgba(0,0,0,.45);
  backdrop-filter:blur(8px);
  -webkit-backdrop-filter:blur(8px);
  opacity:0;
  pointer-events:none;
  transition:opacity .3s ease;
}
.pip{
  position:fixed;
  z-index:51;
  right:18px;
  bottom:18px;
  width:min(680px,calc(100% - 36px));
  max-height:min(760px,calc(100vh - 36px));
  overflow:auto;
  border:1px solid rgba(255,255,255,.13);
  border-radius:28px;
  background:rgba(17,18,22,.91);
  backdrop-filter:blur(30px);
  -webkit-backdrop-filter:blur(30px);
  box-shadow:0 35px 120px rgba(0,0,0,.55),inset 0 1px rgba(255,255,255,.1);
  transform:translateY(35px) scale(.96);
  opacity:0;
  pointer-events:none;
  transition:
    transform .4s cubic-bezier(.2,.85,.2,1),
    opacity .28s ease;
}
.pip.open,
.pip-backdrop.open{
  opacity:1;
  pointer-events:auto;
}
.pip.open{transform:translateY(0) scale(1)}
.pip-head{
  position:sticky;
  top:0;
  z-index:2;
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:20px 22px;
  border-bottom:1px solid var(--line);
  background:rgba(17,18,22,.78);
  backdrop-filter:blur(20px);
}
.pip-kicker{
  color:var(--muted);
  font-size:10px;
  text-transform:uppercase;
  letter-spacing:.15em;
}
.pip-title{
  margin-top:4px;
  font-size:20px;
  font-weight:680;
  letter-spacing:-.02em;
}
.close{
  width:36px;height:36px;
  border-radius:50%;
  border:1px solid var(--line);
  background:rgba(255,255,255,.055);
  font-size:18px;
}
.pip-body{padding:22px}
.pip-state{
  padding:18px;
  border:1px solid var(--line);
  border-radius:18px;
  background:rgba(255,255,255,.035);
}
.pip-state strong{display:block;font-size:14px}
.pip-state span{
  display:block;
  margin-top:7px;
  color:var(--muted);
  font-size:12px;
  line-height:1.55;
}
.data-list{margin-top:12px;display:flex;flex-direction:column;gap:8px}
.data-row{
  display:flex;
  justify-content:space-between;
  gap:20px;
  padding:13px 14px;
  border-radius:14px;
  background:rgba(255,255,255,.035);
  font-size:12px;
}
.data-row span:first-child{color:var(--muted)}
.data-row span:last-child{text-align:right;word-break:break-word}
.empty{color:var(--muted);font-size:12px;padding:12px 0}
.error{color:var(--red)!important}

@media(max-width:600px){
  .app{width:min(100% - 24px,1120px);padding-top:16px}
  .topbar{padding-bottom:22px}
  .hero{padding:25px 0 30px}
  .hero-copy{font-size:14px}
  .system-card{margin-bottom:38px;padding:18px}
  .module{min-height:80px;padding:17px}
  .module-icon{width:38px;height:38px;border-radius:12px}
  .pip{
    right:8px;left:8px;bottom:8px;
    width:auto;
    max-height:calc(100vh - 16px);
    border-radius:26px;
  }
  .footer{padding-bottom:20px}
}
@media(prefers-reduced-motion:reduce){
  *,*:before,*:after{
    animation-duration:.01ms!important;
    animation-iteration-count:1!important;
    scroll-behavior:auto!important;
    transition-duration:.01ms!important;
  }
}
</style>
</head>

<body>
<div class="ambient"><div class="orb"></div><div class="orb"></div></div>

<main class="app">
  <header class="topbar">
    <div class="brand">
      <div class="logo">OX</div>
      <div>
        <div class="brand-name">ONYX</div>
        <div class="brand-sub">Command Center</div>
      </div>
    </div>
    <div class="live"><span class="live-dot"></span><span id="liveText">Checking</span></div>
  </header>

  <section class="hero">
    <div class="eyebrow">Control surface</div>
    <h1>Everything important.<br>One clean surface.</h1>
    <p class="hero-copy">
      A focused workspace for system status, devices, files, audit and administration.
      Select a section to open its workspace without leaving the dashboard.
    </p>
  </section>

  <section class="system-card">
    <div>
      <div class="system-title">ONYX system</div>
      <div class="system-meta" id="healthMeta">Connecting to backend…</div>
    </div>
    <div class="system-status" id="healthBadge">CHECKING</div>
  </section>

  <section>
    <div class="section-label">Workspace</div>

    <div class="modules">
      <button class="module" onclick="openPip('devices')">
        <div class="module-left">
          <div class="module-icon">◉</div>
          <div>
            <div class="module-title">Devices</div>
            <div class="module-desc">Connected device inventory and status</div>
          </div>
        </div>
        <div class="arrow">›</div>
      </button>

      <button class="module" onclick="openPip('files')">
        <div class="module-left">
          <div class="module-icon">□</div>
          <div>
            <div class="module-title">Files</div>
            <div class="module-desc">Device file workspace</div>
          </div>
        </div>
        <div class="arrow">›</div>
      </button>

      <button class="module" onclick="openPip('audit')">
        <div class="module-left">
          <div class="module-icon">≡</div>
          <div>
            <div class="module-title">Audit</div>
            <div class="module-desc">Activity and security history</div>
          </div>
        </div>
        <div class="arrow">›</div>
      </button>

      <button class="module" onclick="openPip('pipeline')">
        <div class="module-left">
          <div class="module-icon">⌁</div>
          <div>
            <div class="module-title">Pipeline</div>
            <div class="module-desc">System workflow workspace</div>
          </div>
        </div>
        <div class="arrow">›</div>
      </button>

      <button class="module" onclick="openPip('admin')">
        <div class="module-left">
          <div class="module-icon">◇</div>
          <div>
            <div class="module-title">Administration</div>
            <div class="module-desc">Products and system administration</div>
          </div>
        </div>
        <div class="arrow">›</div>
      </button>
    </div>
  </section>

  <footer class="footer">
    <span>ONYX</span>
    <span id="clock"></span>
  </footer>
</main>

<div class="pip-backdrop" id="backdrop" onclick="closePip()"></div>

<section class="pip" id="pip" aria-modal="true" role="dialog">
  <div class="pip-head">
    <div>
      <div class="pip-kicker">Workspace</div>
      <div class="pip-title" id="pipTitle">ONYX</div>
    </div>
    <button class="close" onclick="closePip()" aria-label="Close">×</button>
  </div>
  <div class="pip-body" id="pipBody"></div>
</section>

<script>
const state = {
  health: null,
  devices: null,
  audit: null
};

const $ = id => document.getElementById(id);

function escapeHtml(value){
  return String(value ?? '')
    .replaceAll('&','&amp;')
    .replaceAll('<','&lt;')
    .replaceAll('>','&gt;')
    .replaceAll('"','&quot;')
    .replaceAll("'","&#039;");
}

async function api(path, options = {}){
  const response = await fetch(path, {
    credentials:'same-origin',
    ...options,
    headers:{
      'Accept':'application/json',
      ...(options.headers || {})
    }
  });

  const text = await response.text();
  let data;
  try { data = text ? JSON.parse(text) : {}; }
  catch { data = {raw:text}; }

  if(!response.ok){
    throw new Error(data.error || data.message || `HTTP ${response.status}`);
  }
  return data;
}

async function checkHealth(){
  try{
    const data = await api('/health');
    state.health = data;
    $('healthBadge').textContent = 'ONLINE';
    $('healthMeta').textContent = 'Backend connection established';
    $('liveText').textContent = 'Live';
  }catch(error){
    $('healthBadge').textContent = 'OFFLINE';
    $('healthMeta').textContent = 'Backend unavailable';
    $('liveText').textContent = 'Offline';
  }
}

function openPip(type){
  const titles = {
    devices:'Devices',
    files:'Files',
    audit:'Audit',
    pipeline:'Pipeline',
    admin:'Administration'
  };

  $('pipTitle').textContent = titles[type] || 'ONYX';
  $('pipBody').innerHTML =
    '<div class="pip-state"><strong>Loading workspace</strong><span>Reading live backend data…</span></div>';

  $('backdrop').classList.add('open');
  $('pip').classList.add('open');
  document.body.style.overflow='hidden';

  if(type === 'devices') loadDevices();
  else if(type === 'audit') loadAudit();
  else if(type === 'files') renderInfo(
    'File workspace',
    'Select a device from the Devices workspace to work with its authorized files.'
  );
  else if(type === 'pipeline') renderInfo(
    'Pipeline workspace',
    'Pipeline controls are available through the existing backend contract. The visual workspace is ready for the next integration layer.'
  );
  else if(type === 'admin') renderInfo(
    'Administration',
    'Administrative workspace ready. Existing backend administration endpoints remain unchanged.'
  );
}

function closePip(){
  $('pip').classList.remove('open');
  $('backdrop').classList.remove('open');
  document.body.style.overflow='';
}

function renderInfo(title, text){
  $('pipBody').innerHTML =
    `<div class="pip-state">
      <strong>${escapeHtml(title)}</strong>
      <span>${escapeHtml(text)}</span>
    </div>`;
}

async function loadDevices(){
  try{
    const data = await api('/api/devices/');
    state.devices = Array.isArray(data) ? data : (data.devices || data.data || []);
    const devices = state.devices;

    if(!devices.length){
      renderInfo('No devices', 'No device records were returned by the backend.');
      return;
    }

    $('pipBody').innerHTML = `
      <div class="pip-state">
        <strong>${devices.length} device${devices.length === 1 ? '' : 's'}</strong>
        <span>Live inventory returned by ONYX.</span>
      </div>
      <div class="data-list">
        ${devices.map((d,i)=>`
          <div class="data-row">
            <span>${escapeHtml(d.name || d.device_name || `Device ${i+1}`)}</span>
            <span>${escapeHtml(d.status || 'unknown')}</span>
          </div>
        `).join('')}
      </div>`;
  }catch(error){
    $('pipBody').innerHTML =
      `<div class="pip-state">
        <strong>Could not load devices</strong>
        <span class="error">${escapeHtml(error.message)}</span>
      </div>`;
  }
}

async function loadAudit(){
  try{
    const data = await api('/api/audit/logs');
    state.audit = Array.isArray(data) ? data : (data.logs || data.data || []);

    if(!state.audit.length){
      renderInfo('No audit events', 'The backend returned no audit records.');
      return;
    }

    const logs = state.audit.slice(0,30);

    $('pipBody').innerHTML = `
      <div class="pip-state">
        <strong>Recent activity</strong>
        <span>Showing the latest ${logs.length} backend audit records.</span>
      </div>
      <div class="data-list">
        ${logs.map(log=>`
          <div class="data-row">
            <span>${escapeHtml(log.action || 'Event')}</span>
            <span>${escapeHtml(log.timestamp || log.created_at || '')}</span>
          </div>
        `).join('')}
      </div>`;
  }catch(error){
    $('pipBody').innerHTML =
      `<div class="pip-state">
        <strong>Could not load audit</strong>
        <span class="error">${escapeHtml(error.message)}</span>
      </div>`;
  }
}

function updateClock(){
  $('clock').textContent =
    new Intl.DateTimeFormat([],{
      hour:'2-digit',
      minute:'2-digit',
      second:'2-digit'
    }).format(new Date());
}

document.addEventListener('keydown', e=>{
  if(e.key === 'Escape') closePip();
});

checkHealth();
updateClock();
setInterval(updateClock,1000);
setInterval(checkHealth,15000);
</script>
</body>
</html>
